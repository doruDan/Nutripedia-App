@model FoodAppV1.Models.Food
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
   
    if(Model == null) {<h1>No food data found!</h1>}
    
    <h2>Nutritional Information for: @Model.description</h2>
    <p><strong>ID: @Model.fdcId</strong></p>

    <hr />

    <h3>Nutrients</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Nutrient</th>
                <th>Value</th>
                <th>Measurement Unit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nutrient in Model.foodNutrients)
            {
                <tr>
                    <td>@nutrient.nutrientName</td>
                    <td>@nutrient.value</td>
                    <td>@nutrient.unitName</td>
                </tr>
            }
        </tbody>
    </table>
}
